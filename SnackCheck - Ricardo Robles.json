      "name": "Crear mensaje con IA"
    },
    {
      "parameters": {
        "jsCode": "const item = $json;\nconst clasificacion = [$json.Azúcar, $json.Sal, $json.Grasa];\nconst altos = clasificacion.filter(n => (n ?? '').toString().trim().toLowerCase() === 'alto').length;\n\nlet resultado;\nif (altos >= 2) resultado = 'No Saludable';\nelse if (altos === 1) resultado = 'Moderado';\nelse resultado = 'Saludable'\n\nconst preocupacion = altos\n\nconst severidad = { Saludable: 0, Moderado: 1, 'No Saludable': 2}\nconst mapaNutriscore = {\n  a: 'saludable',\n  b: 'saludable',\n  c: 'moderado',\n  d: 'no saludable',\n  e: 'no saludable'\n};\n\nconst nutriscoreRaw = (item.Nutriscore ?? '').toString().trim().toLowerCase();\nconst esValido = Object.keys(mapaNutriscore).includes(nutriscoreRaw);\n\nlet veredicto\n{\n  const categoriaNutriscore = mapaNutriscore[nutriscoreRaw];\n  veredicto = severidad[categoriaNutriscore] >= severidad[item.resultado]\n    ? categoriaNutriscore\n    : resultado;\n}\n\nreturn [{\n  json: {\n    ...item,\n    resultado,\n    preocupacion,\n    veredicto\n  }\n}];"
      },
